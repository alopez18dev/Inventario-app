# Copia este archivo como .env y completa los valores.

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos local (se usa cuando no existe DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres

# Base de datos en producción (Neon u otro proveedor).
# Si está definida, tiene prioridad sobre las variables DB_*.
# DATABASE_URL=postgresql://usuario:contraseña@servidor/base?sslmode=require

# Secreto para firmar los tokens. Genera uno con:
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Origen permitido por CORS: la URL del frontend, sin barra final
FRONTEND_URL=http://localhost:5173

# Número de proxies de confianza delante de Express (0 en local)
TRUST_PROXY=0